#!/usr/bin/env bash
# Niri port of sway/scripts/lid.
# Suspend on lid-close only if no external monitor is attached.
#
# Niri's KDL config has no `bindswitch lid:on` equivalent. Wire this script up
# instead via systemd-logind:
#
#   /etc/systemd/logind.conf.d/99-niri-lid.conf:
#     [Login]
#     HandleLidSwitch=ignore
#     HandleLidSwitchExternalPower=ignore
#     HandleLidSwitchDocked=ignore
#
# ...then have hypridle / swayidle invoke this script on the corresponding event.

set -euo pipefail

monitor_count=$(niri msg --json outputs | jq 'length')

if (( monitor_count > 1 )); then
  echo "Multiple monitors connected; not suspending."
  exit 0
fi

echo "Single monitor; suspending."
~/.config/hypr/scripts/suspend
