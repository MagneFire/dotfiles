include "monitor.kdl"

// Niri port of scroll/sway config.
// Deploy to ~/.config/niri/config.kdl. Scripts in this folder go to ~/.config/niri/scripts/.
//
// Notable scroll features WITHOUT a niri equivalent (commented inline where relevant):
//   - scale_workspace / scale_content (zoom): niri's `toggle-overview` is the nearest analogue.
//   - modal bindings (mode "setsizeh", "align", "fit_size"): niri has only flat key bindings.
//   - layout_default_width / layout_widths arrays: niri uses preset-column-widths cycling.
//   - "jump" / overview window picker: use the overview + scrollable focus.
//
// Vars-equivalent: niri has no `set $var`, so paths/binaries are inlined below.
// $terminal=kitty, $webBrowser=zen-browser, $fileManager=dolphin, $menu=albert (via socat IPC).

input {
    keyboard {
        xkb {
            options "compose:ralt"
        }
        numlock
    }

    touchpad {
        tap
        dwt
        natural-scroll
        middle-emulation
    }

    // Focus-on-window-activation analogue: niri has no global setting; it always raises
    // urgent windows briefly. The custom `focus_on_urgent` script is no longer needed.
    focus-follows-mouse
}

// ---- LAYOUT ----

layout {
    // Scroll's `layout_widths [0.33 0.5 0.667 1.0]` → niri preset list
    // (cycled via switch-preset-column-width).
    preset-column-widths {
        proportion 0.333333
        proportion 0.5
        proportion 0.666667
        proportion 1.0
    }

    preset-window-heights {
        proportion 0.333333
        proportion 0.5
        proportion 0.666667
        proportion 1.0
    }

    // scroll: layout_default_width 0.5
    default-column-width { proportion 0.5; }

    // sway lookfeel.conf gaps
    gaps 5

    // sway default_border pixel 2 + focused border color
    border {
        width 2
        active-color "#c3dde7"
        inactive-color "#928374"
        urgent-color "#e78a4e"
    }

    focus-ring {
        off
    }

    // scroll: focus_wrapping no
    // (niri default is no wrap, matches scroll's setting.)
}

prefer-no-csd

cursor {
    hide-when-typing
}

// Niri ships a hotkey overlay on first launch; this hides it.
hotkey-overlay {
    skip-at-startup
}

// ---- AUTOSTART ----
// Ported from sway/autostart. Niri runs spawn-at-startup once per session.
// One-shots (dbus env import, kded6 stub) are wrapped in the autostart script
// since they need shell features.

spawn-at-startup "sh" "-c" "~/.config/niri/autostart"

// ---- BLUR ----
// Global blur uses niri's defaults (passes 3, offset 3, noise 0.02, saturation 1.5).
// Per-app/layer rules below enable blur on transparent surfaces. The window itself
// must be semitransparent for the blur to be visible.

window-rule {
    match app-id="^kitty$"
    background-effect {
        blur true
    }
}

// Layer-shell surfaces (waybar, swaync) are transparent.
layer-rule {
    match namespace="^waybar$"
    background-effect {
        blur true
    }
}

// swaync creates two layer surfaces: `swaync-control-center` (the sidebar
// panel) and `swaync-notification-window` (the actual notification popup).
// Match only the notification — blurring the panel makes its full anchored
// rectangle visible as a halo even when transparent.
layer-rule {
    match namespace="^swaync-notification-window$"
    geometry-corner-radius 12
}

// ---- WINDOW RULES ----
// Ported from sway/config.d/window-rules.conf and scroll/config.d/window-rules.conf.

// scroll: idle inhibit for any fullscreen window — handled implicitly. Niri has
// no per-rule idle-inhibit action; apps that go fullscreen request inhibition
// via the wlr-idle-inhibit-unstable-v1 protocol and swayidle/hypridle respect
// it. No rule needed.

// Picture-in-Picture: float + always-on-top
window-rule {
    match title="^Picture-in-Picture$"
    open-floating true
}

// Gnome calculator: float, fixed size, centered
window-rule {
    match app-id="^org.gnome.Calculator$"
    open-floating true
    default-column-width { fixed 648; }
    default-window-height { fixed 688; }
}

// Ghidra: float ancillary windows (non-CodeBrowser, non-main)
window-rule {
    match app-id="ghidra-Ghidra"
    exclude title="^(CodeBrowser|Ghidra).*"
    open-floating true
}

// Albert launcher: fixed size, floating, and no solid backdrop behind it
// (niri otherwise paints a window-background color where albert is transparent).
window-rule {
    match app-id="^albert$"
    open-floating true
    // No fixed width/height: forcing them produced GL_INVALID_VALUE texture
    // uploads because albert's actual surface size (~229px tall) didn't match
    // the requested 521px. Let albert size itself.
    draw-border-with-background false
    border {
        off
    }
    // No blur: Qt reports albert's geometry as the full surface including its
    // CSD shadow, so blur (even with clip-to-geometry) extends past the visible
    // launcher into a halo around it. Leave albert transparent over the
    // wallpaper directly.
}

// sdl-freerdp3: explicitly tile (sway had `floating disable`)
window-rule {
    match app-id="^sdl-freerdp3$"
    open-floating false
}

// ---- KEY BINDINGS ----

binds {
    // ---- Functional ----
    Mod+Q { close-window; }
    Mod+Shift+Q { spawn "sh" "-c" "~/.config/niri/scripts/force_kill_active"; }
    Mod+Shift+E { quit; }
    // Niri reloads its config automatically on save; bind explicit reload for parity.
    // No `reload` action in niri — config is hot-reloaded from disk.

    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    // sway "floating toggle" → niri's tile/float toggle
    Mod+Ctrl+F { toggle-window-floating; }

    // sway J: layout toggle split — no niri equivalent (no nested splits).
    // Closest analogue: consume/expel windows in/out of columns.
    Mod+J { consume-or-expel-window-left; }
    Mod+K { consume-or-expel-window-right; }

    // ---- Focus / Movement ----
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }

    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Down  { move-window-down; }

    // sway Ctrl+Arrow: move container to output + focus that output.
    // niri's move-column-to-monitor-* moves focus along with the column, so
    // no separate focus-monitor-* call is needed (and not allowed: one action
    // per binding).
    Mod+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Ctrl+Down  { move-column-to-monitor-down; }

    // sway Alt+Arrow: move whole workspace to output
    Mod+Alt+Left  { move-workspace-to-monitor-left; }
    Mod+Alt+Right { move-workspace-to-monitor-right; }
    Mod+Alt+Up    { move-workspace-to-monitor-up; }
    Mod+Alt+Down  { move-workspace-to-monitor-down; }
    Mod+Alt+Page_Up   { move-workspace-to-monitor-up; }
    Mod+Alt+Page_Down { move-workspace-to-monitor-down; }

    // ---- Workspaces ----
    // Niri workspaces flow vertically per output; we keep numeric keys.
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    // sway Page_Up / Page_Down + Z/X workspace cycling
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }
    Mod+Z         { focus-workspace-up; }
    Mod+X         { focus-workspace-down; }

    // sway: insert new workspace adjacent to current
    Mod+Shift+Z { spawn "sh" "-c" "~/.config/niri/scripts/insert_workspace prev"; }
    Mod+Shift+X { spawn "sh" "-c" "~/.config/niri/scripts/insert_workspace next"; }
    Mod+A       { spawn "sh" "-c" "~/.config/niri/scripts/workspace_new"; }

    Mod+Home { focus-workspace 1; }
    // sway "end": go to empty workspace at the end. Niri always keeps an empty
    // workspace last, so focus-workspace-down repeatedly via this script:
    Mod+End  { spawn "sh" "-c" "~/.config/niri/scripts/workspace end"; }

    // sway "back_and_forth" → niri's previous-workspace
    Mod+BackSpace { focus-workspace-previous; }

    // sway: move container to next/prev workspace on this output
    Mod+Shift+Page_Down { move-column-to-workspace-down; }
    Mod+Shift+Page_Up   { move-column-to-workspace-up; }
    // sway: "Shift+Right/Left moves window to next/prev workspace" — collides with
    // move-column-left/right above. We keep the column-move semantics on Shift+Arrow
    // and route the workspace-move feature to a dedicated key:
    Mod+Shift+BracketLeft  { move-column-to-workspace-up; }
    Mod+Shift+BracketRight { move-column-to-workspace-down; }

    // ---- Scroll-style sizing ----
    // scroll: cycle_size h prev / next
    Mod+Minus { switch-preset-column-width-back; }
    Mod+Equal { switch-preset-column-width; }
    Mod+Shift+Minus { switch-preset-window-height-back; }
    Mod+Shift+Equal { switch-preset-window-height; }

    // scroll: align center (column horizontally centered on screen)
    Mod+Shift+A { center-column; }

    // scroll: fit_size analogues — niri has only "expand to fill available width".
    Mod+Shift+W { expand-column-to-available-width; }

    // scroll: overview
    Mod+Tab { toggle-overview; }

    // ---- Media / Brightness (swayosd works under niri) ----
    XF86AudioRaiseVolume allow-when-locked=true { spawn "swayosd-client" "--output-volume" "raise"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "swayosd-client" "--output-volume" "lower"; }
    XF86AudioMute        allow-when-locked=true { spawn "swayosd-client" "--output-volume" "mute-toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "swayosd-client" "--input-volume" "mute-toggle"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "swayosd-client" "--brightness" "raise"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "swayosd-client" "--brightness" "lower"; }
    XF86AudioPlay  allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPause allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPrev  allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86AudioNext  allow-when-locked=true { spawn "playerctl" "next"; }

    // ---- Helpers ----
    Mod+Space      { spawn "sh" "-c" "echo -n '[\"show\", \"apps \"]' | socat - ~/.cache/albert/ipc_socket"; }
    Mod+L          { spawn "loginctl" "lock-session"; }
    Mod+D          { spawn "sh" "-c" "$HOME/.config/hypr/scripts/do_not_disturb"; }
    Mod+P          { spawn "sh" "-c" "echo -n '[\"show\", \"system \"]' | socat - ~/.cache/albert/ipc_socket"; }
    Mod+E          { spawn "sh" "-c" "echo -n '[\"show\", \"emoji \"]' | socat - ~/.cache/albert/ipc_socket"; }
    Mod+N          { spawn "sh" "-c" "$HOME/.config/hypr/scripts/waybar-toggle"; }
    Mod+Shift+N    { spawn "swaync-client" "-t" "-sw"; }

    // sway Alt+Tab window switcher (eww-based) — left as spawn so the user can
    // wire it up to a niri-compatible launcher (e.g. fuzzel --window-mode).
    Alt+Tab { spawn "sh" "-c" "fuzzel --list-launch-prefix='niri msg action focus-window --id ' --show-actions"; }

    // ---- Screenshots ----
    // Niri ships its own screenshot UI.
    Print           { screenshot; }
    Shift+Print     { screenshot-screen; }
    Mod+Print       { screenshot-window; }
    Alt+Print       { spawn "sh" "-c" "f=$(mktemp --suffix=.png); grim -g \"$(slurp)\" \"$f\" && tesseract \"$f\" - | wl-copy && rm \"$f\""; }
    Ctrl+Print      { spawn "hyprpicker" "-a"; }

    // ---- Apps ----
    Mod+Return       { spawn "kitty"; }
    Mod+KP_Enter     { spawn "kitty"; }
    Mod+T            { spawn "kitty"; }
    Mod+B            { spawn "blueman-manager"; }
    Mod+V            { spawn "pavucontrol"; }
    Mod+M            { spawn "nwg-displays"; }
    Mod+W            { spawn "zen-browser"; }
    Mod+H            { spawn "dolphin"; }
    Mod+C            { spawn "sh" "-c" "echo -n '[\"show\", \"code \"]' | socat - ~/.cache/albert/ipc_socket"; }
    Mod+R            { spawn "gnome-calculator"; }

    // ---- Mouse / scroll-style mouse bindings ----
    // sway whole-window Mod+button{6,7}: workspace prev/next via side buttons.
    // Niri binds mouse buttons in the same `binds` block:
    Mod+MouseBack    { focus-workspace-up; }
    Mod+MouseForward { focus-workspace-down; }

    // sway scroll wheel resize equivalents
    Mod+WheelScrollDown { switch-preset-column-width; }
    Mod+WheelScrollUp   { switch-preset-column-width; }
    Mod+Shift+WheelScrollDown { switch-preset-window-height; }
    Mod+Shift+WheelScrollUp   { switch-preset-window-height; }
}

// ---- GESTURES ----
// sway had bindgesture swipe:3:right/left for workspace prev/next + next-new.
// Niri reserves 4-finger swipes for its own overview/workspace-switch and does
// not expose custom gesture bindings. The user's existing `fusuma` daemon
// (started in autostart) can be configured to call `niri msg action` instead.

// Lid handling: niri has no built-in lid hook. The sway `lid` script (suspend
// only when no external monitor) is ported and lives in scripts/. Wire it up
// via swayidle or systemd-logind's HandleLidSwitch — niri config can't bind
// switches directly.
